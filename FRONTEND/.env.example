# WIN.AGDATA Frontend Environment Configuration
# Copy this file to .env.local and update values as needed

# Backend API Configuration
ANGULAR_APP_API_URL=http://localhost:5000/api
ANGULAR_APP_API_TIMEOUT=30000

# Application Configuration
ANGULAR_APP_NAME=WIN.AGDATA
ANGULAR_APP_VERSION=1.0.0

# Feature Flags
ANGULAR_APP_ENABLE_DEMO_MODE=true
